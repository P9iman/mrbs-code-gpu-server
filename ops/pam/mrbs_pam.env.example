# Copy to /etc/security/mrbs-pam.env and chmod 600.

# Database name used by MRBS
MRBS_DB_NAME=mrbs

# VM identifier matched against mrbs_vm_access_map.vm_hostname
# Use a stable DNS name or fixed host label.
MRBS_VM_HOSTNAME=gpu-vm-01

# owner_only | owner_or_participant
MRBS_POLICY=owner_or_participant

# Optional comma-separated bypass users (eg break-glass admins)
# MRBS_BYPASS_USERS=root,opsadmin
